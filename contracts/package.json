{
  "name": "dobby-contracts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "pnpm lint:sol && pnpm lint:ts",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:ts": "eslint '**/*.ts'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix && eslint '**/*.ts' --fix",
    "prettier": "prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
    "build:artifacts": "hardhat compile && mkdir -p ../backend/artifacts && cp -r artifacts/contracts ../backend/artifacts/",
    "deploy": "hardhat ignition deploy --network sepolia ignition/modules/GovernanceModule.ts",
    "analyze:gas": "tsx scripts/analysis/analyze-gas.ts",
    "analyze:events": "hardhat run scripts/analysis/export-events.ts --network sepolia",
    "gov:propose": "tsx scripts/governance/propose-general.ts",
    "gov:propose-package": "tsx scripts/governance/propose-package.ts",
    "gov:vote": "tsx scripts/governance/vote.ts",
    "gov:queue": "tsx scripts/governance/queue.ts",
    "gov:execute": "tsx scripts/governance/execute.ts",
    "gov:state": "tsx scripts/governance/state.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.1",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@types/chai": "^5.2.2",
    "@types/node": "^22.8.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "chai": "^4.3.7",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "globals": "^16.5.0",
    "hardhat": "^3.0.7",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "solhint": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.49.0",
    "viem": "^2.30.0"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-keystore": "^3.0.1",
    "@openzeppelin/contracts": "^5.4.0"
  }
}
